<section class="wrap">
  <div class="row"><h2>{{ section.settings.heading }}</h2>{% if section.settings.collection != blank %}<a href="{{ section.settings.collection.url }}">View all</a>{% endif %}</div>
  <div class="grid">
    {% for product in section.settings.collection.products limit: section.settings.count %}{% render 'product-card', product: product %}
    {% else %}{% for i in (1..4) %}<div class="card"><div class="card-img">{{ 'product-1' | placeholder_svg_tag }}</div><h3>Example product</h3></div>{% endfor %}{% endfor %}
  </div>
</section>
{% schema %}
{"name":"Featured collection","settings":[
 {"type":"text","id":"heading","label":"Heading","default":"New in"},
 {"type":"collection","id":"collection","label":"Collection"},
 {"type":"range","id":"count","label":"Products","min":2,"max":12,"step":2,"default":4}
],"presets":[{"name":"Featured collection"}]}
{% endschema %}
