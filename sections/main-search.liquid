<section class="wrap">
  <h1>Search</h1>
  <form action="{{ routes.search_url }}" method="get" class="searchbar" role="search"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products" aria-label="Search"><input type="hidden" name="type" value="product"><button class="btn">Search</button></form>
  {% if search.performed %}
    {% paginate search.results by 12 %}
    <p class="mute">{{ search.results_count }} results for "{{ search.terms }}"</p>
    <div class="grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>
    {% if paginate.pages > 1 %}<nav class="pager">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">Previous</a>{% endif %}{% if paginate.next %}<a href="{{ paginate.next.url }}">Next</a>{% endif %}</nav>{% endif %}
    {% endpaginate %}
  {% endif %}
</section>
{% schema %}
{"name":"Search"}
{% endschema %}
