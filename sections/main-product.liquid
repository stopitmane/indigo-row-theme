{%- assign current = product.selected_or_first_available_variant -%}
<section class="pdp wrap" data-product>
  <div class="gal">
    <div class="thumbs">
      {% for media in product.media %}<button type="button" data-thumb="{{ media.id }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }}">{{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}</button>{% endfor %}
    </div>
    <div class="stage">
      {% for media in product.media %}<div class="slide" data-media="{{ media.id }}"{% unless forloop.first %} hidden{% endunless %}>{{ media.preview_image | image_url: width: 1200 | image_tag: loading: 'eager', sizes: '(min-width:820px) 55vw, 100vw', alt: media.alt }}</div>
      {% else %}{{ 'product-1' | placeholder_svg_tag }}{% endfor %}
    </div>
  </div>

  <div class="info">
    {% if section.settings.show_vendor %}<p class="mute">{{ product.vendor }}</p>{% endif %}
    <h1>{{ product.title }}</h1>
    <p class="price big" data-price>{% if current.compare_at_price > current.price %}<s>{{ current.compare_at_price | money }}</s> {% endif %}{{ current.price | money }}</p>
    <div class="rte lead">{{ product.description }}</div>

    {%- form 'product', product, id: 'product-form', data-product-form: '' -%}
      <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <fieldset data-option="{{ forloop.index0 }}">
            <legend>{{ option.name }}<span>{{ option.selected_value }}</span></legend>
            <div class="opts">
              {% for value in option.values %}
                <label class="chip"><input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}><span>{{ value }}</span></label>
              {% endfor %}
            </div>
          </fieldset>
        {% endfor %}
      {% endunless %}
      <div class="buy">
        <div class="qty"><button type="button" data-qty="-1" aria-label="Decrease quantity">&minus;</button><input type="number" name="quantity" value="1" min="1" aria-label="Quantity"><button type="button" data-qty="1" aria-label="Increase quantity">+</button></div>
        <button type="submit" class="btn atc" data-atc{% unless current.available %} disabled{% endunless %}>{% if current.available %}Add to cart{% else %}Sold out{% endif %}</button>
      </div>
    {%- endform -%}
    {% if section.settings.note != blank %}<p class="mute small">{{ section.settings.note }}</p>{% endif %}

    {% for block in section.blocks %}
      <details {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}><summary>{{ block.settings.heading }}</summary><div class="rte">{{ block.settings.text }}</div></details>
    {% endfor %}
  </div>

  <script type="application/json" data-variants>
  [{% for v in product.variants %}{"id":{{ v.id }},"options":{{ v.options | json }},"price":{{ v.price | money | json }},"compare":{{ v.compare_at_price | money | json }},"sale":{% if v.compare_at_price > v.price %}true{% else %}false{% endif %},"available":{{ v.available }},"media":{{ v.featured_media.id | default: 0 }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
  </script>
</section>
{% schema %}
{"name":"Product","settings":[
 {"type":"checkbox","id":"show_vendor","label":"Show vendor","default":true},
 {"type":"text","id":"note","label":"Note under button","default":"Ships from Lagos in 3 to 5 days. Free returns within 14 days."}
],
"blocks":[{"type":"accordion","name":"Accordion","settings":[{"type":"text","id":"heading","label":"Heading","default":"Details"},{"type":"richtext","id":"text","label":"Text","default":"<p>Add product details here.</p>"}]}],
"presets":[{"name":"Product"}]}
{% endschema %}
